RewriteEngine On

# Redirect only the www host to the canonical non-www host.
# Do not force HTTPS here: the live hosting layer is already terminating HTTPS,
# and applying an HTTPS redirect based on %{HTTPS} can create a redirect loop
# when the hosting/proxy layer reports the origin request as HTTP.
RewriteCond %{HTTP_HOST} ^www\.budgetcleaning\.co\.za$ [NC]
RewriteRule ^ https://budgetcleaning.co.za%{REQUEST_URI} [R=301,L]

# Keep crawler-control files as direct static files.
RewriteRule ^sitemap\.xml$ - [L]
RewriteRule ^robots\.txt$ - [L]

# Explicit MIME types for crawler files.
AddType application/xml .xml
AddType text/plain .txt
